"""Recipe for books/$slug. Generated by `pdf2epub new`: the layout and sections are guesses.

Check every TODO, then iterate:
    ./pdf2epub inspect $slug outline        # where chapters start
    ./pdf2epub inspect $slug lines 20,21    # how the pipeline sees a page
    ./pdf2epub build $slug                  # read the classification report and WARN lines
"""
from pdf2epub.recipe import Heuristics, Layout, Recipe, Section

RECIPE = Recipe(
    title=$title,  # TODO
    author=$author,  # TODO
    author_file_as=None,  # TODO "Last, First"
    language=$language,  # TODO BCP 47 code: "en", "ro", ...
    date=None,
    rights=None,  # e.g. "Copyright © Author, 2023. All rights reserved."
    source=None,  # e.g. "Print edition, 2023"

    # Page geometry, suggested by `inspect $slug layout`.
    layout=Layout(
        page_width=$page_width,
        left=$left,  # page parity (1 = odd, 0 = even) -> left edge of the text block
        text_width=$text_width,
        header_max_y=$header_max_y,  # running heads sit above this baseline
        folio_min_y=$folio_min_y,  # page numbers sit below this baseline
        folio_size=$folio_size,
        footnote_max_size=$footnote_max_size,  # smaller lines are footnotes (0 = none)
    ),
    heuristics=Heuristics(line_pitch=$line_pitch, chapter_min_size=$chapter_min_size),
    junk_fonts=(),  # font-name prefixes of decorative glyphs (ornaments, dingbats) to drop

    cover_page=1,  # TODO PDF page rendered as the cover image (None: no cover)
    title_page_lines=None,  # title-page lines, e.g. ["THE LONG", "TITLE"] (default: TITLE)
    copyright_page=None,  # TODO PDF page whose text becomes the copyright page
    copyright_min_y=0.0,
    page_offset=0,  # printed page number = PDF page + page_offset (`inspect $slug labels`)
    tables={},  # PDF page -> x splitting a two-column table

    # One XHTML file per section; kind: front | chapter | back | biblio.
    # TODO merge, split and rename these; pages before the first section are dropped.
    sections=[
$sections
    ],
)
